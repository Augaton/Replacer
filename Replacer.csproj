<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Replacer</AssemblyName>
    <RootNamespace>Replacer</RootNamespace>
    <Version>2.0.0</Version>
    <Configurations>Debug;Release</Configurations>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType Condition=" '$(Configuration)' == 'Release' ">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExMod.Exiled" Version="9.14.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="HintServiceMeow-Exiled" Version="5.5.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
